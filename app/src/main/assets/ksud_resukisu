#!/system/bin/sh
# DirtyFrag ReSukiSU backend shim.
# The dirtyfrag LKM invokes this file in place of a bundled ksud binary. We
# defer to the ksud shipped inside the ReSukiSU manager app, so the root
# daemon always matches whatever manager version the user has installed.

KSUD=$(find /data/app -path '*/com.resukisu.resukisu*/lib/arm64/libksud.so' 2>/dev/null | head -1)
if [ -z "$KSUD" ]; then
    KSUD=/data/adb/ksu/bin/ksud
fi
if [ ! -f "$KSUD" ]; then
    echo "no ReSukiSU manager found (install com.resukisu.resukisu first)"
    exit 1
fi
chmod 755 "$KSUD" 2>/dev/null

# ReSukiSU late-load takes a KMI; the flags the LKM passes us are translated
# below (soft reboot) or re-implemented here (ro partitions).
KVER=$(uname -r | cut -d. -f1-2)
AVER=$(uname -r | grep -o 'android[0-9]*')

# RO partition protection (parity with diabl0w ksud --ro-partitions), done
# while SELinux is still permissive so the ioctls cannot be denied. Clears
# on reboot, same as the ksud implementation.
for p in /dev/block/by-name/system* /dev/block/by-name/vendor* \
         /dev/block/by-name/boot* /dev/block/by-name/init_boot* \
         /dev/block/by-name/vbmeta*; do
    [ -e "$p" ] && blockdev --setro "$p" 2>/dev/null
done

"$KSUD" late-load --kmi "${AVER}-${KVER}"
rc=$?

# The LKM passes --soft-reboot when the Auto reboot toggle is on. ReSukiSU
# implements soft reboot as a separate subcommand; wait until the kernel
# module is actually up, then trigger it. Bounded loop so a failed load can
# never reboot-loop the device.
for a in "$@"; do
    if [ "$a" = "--soft-reboot" ]; then
        n=0
        while [ $n -lt 60 ]; do
            if grep -q '^kernelsu' /proc/modules 2>/dev/null; then break; fi
            sleep 0.5
            n=$((n + 1))
        done
        if [ $n -lt 60 ]; then
            "$KSUD" soft-reboot
        fi
    fi
done

exit $rc
