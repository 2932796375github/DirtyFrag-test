#!/system/bin/sh
# DirtyFrag Universal - executed as uid 0 by dirtyfrag.ko UMH.
# At this point SELinux is already permissive (written by the module).
DB=/data/user_de/0/df.root
API=$(uname -r | sed -n 's/.*android\([0-9]*\)-.*/\1/p')
KV=$(uname -r | cut -d. -f1-2)
KMI="android${API}-${KV}"
# Install the paired KSU kernel module for this KMI
if [ -f "$DB/kernelsu-$KMI.ko" ]; then
    cp "$DB/kernelsu-$KMI.ko" /data/adb/ksud.ko
else
    cp "$DB/kernelsu-android16-6.12.ko" /data/adb/ksud.ko
fi
# Install the ksud daemon
mkdir -p /data/adb/ksu/bin
cp "$DB/ksu-daemon" /data/adb/ksu/bin/ksud
chmod 755 /data/adb/ksu/bin/ksud
# Late-load: finit_module + syscall hooks + manager pairing
/data/adb/ksu/bin/ksud late-load --package-name me.weishu.kernelsu
exit $?
